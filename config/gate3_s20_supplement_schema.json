{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["slot_id", "draft_role", "query_text"],
  "properties": {
    "slot_id": {"type": "string", "pattern": "^G3S-[0-9]{4}$"},
    "draft_role": {"const": "supplemental"},
    "query_text": {"type": "string", "minLength": 1}
  }
}
