# Copy to .env and fill in. .env is gitignored and must never be committed.
# VARIABLE NAMES ONLY in this file — no values.

# Ollama endpoint. Defaults to http://127.0.0.1:11434 if unset.
NFR_OLLAMA_URL=

# Master write switch. Overrides config/rag.yaml writes.allow_writes when set.
# Leave unset or "false" until Gate 3 is approved.
NFR_ALLOW_WRITES=

# Optional log level: DEBUG | INFO | WARNING | ERROR
NFR_LOG_LEVEL=
