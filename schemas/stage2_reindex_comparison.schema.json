{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "C.Walts Gate 1.2 Stage 2 Reindex Comparison",
  "type": "object",
  "required": [
    "schema_version",
    "generated_at",
    "repository_commit",
    "branch",
    "production_store_identity",
    "proposed_source_identity",
    "mutation_performed",
    "current_production_count",
    "proposed_chunk_count",
    "predicted_production_count",
    "would_add_ids",
    "stale_ids",
    "unchanged_ids",
    "duplicate_ids",
    "content_changed_ids",
    "metadata_changed_ids",
    "proposed_chroma_ids",
    "proposed_bm25_ids",
    "proposed_id_parity",
    "evaluation_case_count",
    "non_allowlisted_changes",
    "findings",
    "verdict"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "generated_at": {"type": "string"},
    "repository_commit": {"type": "string"},
    "branch": {"type": "string"},
    "production_store_identity": {"type": "object"},
    "proposed_source_identity": {"type": "object"},
    "mutation_performed": {"type": "boolean", "const": false},
    "current_production_count": {"type": "integer", "minimum": 0},
    "proposed_chunk_count": {"type": "integer", "minimum": 0},
    "predicted_production_count": {"type": "integer", "minimum": 0},
    "would_add_ids": {"type": "array", "items": {"type": "string"}},
    "stale_ids": {"type": "array", "items": {"type": "string"}},
    "unchanged_ids": {"type": "array", "items": {"type": "string"}},
    "duplicate_ids": {"type": "array", "items": {"type": "string"}},
    "content_changed_ids": {"type": "array", "items": {"type": "string"}},
    "metadata_changed_ids": {"type": "array", "items": {"type": "string"}},
    "source_scoped_current_ids": {"type": "array", "items": {"type": "string"}},
    "source_scoped_proposed_ids": {"type": "array", "items": {"type": "string"}},
    "duplicate_content_groups": {"type": "object"},
    "duplicate_id_groups": {"type": "object"},
    "proposed_chroma_ids": {"type": "array", "items": {"type": "string"}},
    "proposed_bm25_ids": {"type": "array", "items": {"type": "string"}},
    "proposed_id_parity": {"type": "boolean"},
    "evaluation_case_count": {"type": "integer", "minimum": 0},
    "non_allowlisted_changes": {"type": "array"},
    "findings": {"type": "array"},
    "verdict": {"type": "string", "enum": ["pass", "fail"]}
  },
  "additionalProperties": true
}
