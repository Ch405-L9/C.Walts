{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate 3 custom authoring policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "benchmark_version", "source_dataset", "source_version", "authoring_revision", "draft_pool_revision", "id_namespace", "id_range", "all_custom_private_from_creation", "allocation_implied_future_holdout_count", "owner_approval_required", "provenance", "generation_method", "model", "prompt_path", "prompt_sha256", "output_schema_path", "output_schema_sha256", "slot_manifest_path", "slot_manifest_sha256", "generation_parameter_hash", "generation_parameters", "retry_policy", "seed_strategy", "classes", "future_split_targets", "supported_task_matrix", "near_unsupported_families", "far_ood_families", "ambiguous_families", "draft_pool", "group_policy", "privacy", "quality", "generation_run_version", "role_surface_contract_path", "role_surface_contract_id", "role_surface_assignment_id", "role_surface_contract_sha256", "effective_prompt_contract_sha256", "taxonomy_validator_compatibility_path", "failure_audit_path", "generation_authorization_env"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"const": "gate3-custom-authoring-v3"},
    "benchmark_version": {"const": "0.4"},
    "source_dataset": {"const": "custom"},
    "source_version": {"const": "cwalts-custom-v0.4-gate3-v3r1-pool2"},
    "authoring_revision": {"const": "gate3-v3-r1-role-surface"},
    "draft_pool_revision": {"const": "gate3-pool-v2-optional-replacement"},
    "id_namespace": {"const": "^CWQ-CUS-[0-9]{4}$"},
    "id_range": {"const": [1, 285]},
    "all_custom_private_from_creation": {"const": true},
    "allocation_implied_future_holdout_count": {"const": 135},
    "owner_approval_required": {"const": true},
    "provenance": {"type": "object", "additionalProperties": false, "required": ["direct_owner", "local_model"], "properties": {"direct_owner": {"const": "owner_authored"}, "local_model": {"const": "vendor_generated_owner_approved"}}},
    "generation_method": {"const": "hybrid"},
    "model": {"type": "object", "required": ["name", "digest", "model_tag_digest", "model_blob_digest", "ollama_version", "endpoint"], "additionalProperties": true},
    "prompt_path": {"type": "string"},
    "prompt_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "output_schema_path": {"type": "string"},
    "output_schema_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "slot_manifest_path": {"type": "string"},
    "slot_manifest_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generation_parameter_hash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "generation_run_version": {"const": "gate3-b1-v3r1-pool2"},
    "role_surface_contract_path": {"const": "config/gate3_surface_variation_profiles.yaml"},
    "role_surface_contract_id": {"const": "gate3-surface-variation-v1"},
    "role_surface_assignment_id": {"const": "slot-ordinal-mod3-v1"},
    "role_surface_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "effective_prompt_contract_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "taxonomy_validator_compatibility_path": {"type": "string"},
    "failure_audit_path": {"type": "string"},
    "generation_authorization_env": {"const": "NFR_GATE3_B1_V3R1_POOL2_AUTHORIZED"},
    "generation_parameters": {"type": "object"},
    "retry_policy": {"type": "object"},
    "seed_strategy": {"type": "object", "required": ["id", "base_seed", "derivation"], "additionalProperties": false, "properties": {"id": {"type": "string"}, "base_seed": {"type": "integer"}, "derivation": {"type": "string"}}},
    "classes": {"const": {"supported_in_domain": 150, "near_domain_unsupported": 45, "far_out_of_domain": 15, "ambiguous_adversarial_insufficient": 75}},
    "future_split_targets": {"type": "object"},
    "supported_task_matrix": {"type": "object"},
    "near_unsupported_families": {"type": "object"},
    "far_ood_families": {"type": "object"},
    "ambiguous_families": {"type": "object"},
    "draft_pool": {"type": "object", "additionalProperties": false, "required": ["pool_id", "required_slot_count", "required_primary_count", "minimum_replacement_count", "maximum_replacement_count", "minimum_draft_count", "maximum_draft_count", "replacement_omission_condition", "omission_ledger_path"], "properties": {"roles": {"type": "array"}, "pool_id": {"const": "gate3-private-drafts-v3r1-pool2-v0.4"}, "required_slot_count": {"const": 285}, "required_primary_count": {"const": 285}, "minimum_replacement_count": {"const": 0}, "maximum_replacement_count": {"const": 285}, "minimum_draft_count": {"const": 285}, "maximum_draft_count": {"const": 570}, "replacement_policy": {"type": "string"}, "replacement_omission_condition": {"const": "format_safety_failure:replacement_exact_duplicate_on_all_3_attempts"}, "omission_ledger_path": {"const": "var/eval_sources/custom/audit/gate3_replacement_omissions.json"}}},
    "group_policy": {"type": "object"},
    "privacy": {"type": "object", "required": ["private_root", "cloud_generation_permitted", "external_network_permitted", "split_assignment_permitted", "performance_peek_permitted", "gate2_seed_access_permitted"]},
    "quality": {"type": "object"}
  }
}
