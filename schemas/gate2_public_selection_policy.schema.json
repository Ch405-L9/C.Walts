{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gate 2 public selection policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "policy_id", "benchmark_version", "candidate_schema", "provenance_kind", "id_namespace", "acquisition_to_allocation", "quotas", "partition_policy", "label_policy", "expected_behavior", "expected_behavior_by_label", "mixed_cluster_resolution", "group_policy", "duplicate_policy", "balance_algorithm", "future_split_constraints", "no_performance_peek", "no_split"],
  "properties": {
    "schema_version": {"const": 1},
    "policy_id": {"type": "string", "minLength": 1},
    "benchmark_version": {"type": "string", "minLength": 1},
    "candidate_schema": {"const": "schemas/eval_candidate_manifest.schema.json"},
    "provenance_kind": {"const": "public_verbatim"},
    "id_namespace": {"type": "object", "additionalProperties": false, "required": ["prefix", "first", "last", "pattern"], "properties": {"prefix": {"const": "CWQ-PUB"}, "first": {"const": 1}, "last": {"const": 315}, "pattern": {"const": "^CWQ-PUB-[0-9]{4}$"}}},
    "acquisition_to_allocation": {"type": "object", "additionalProperties": false, "required": ["clinc150", "clinc150_oos", "massive_en_us", "banking77"], "properties": {"clinc150": {"const": "clinc150"}, "clinc150_oos": {"const": "clinc150"}, "massive_en_us": {"const": "massive_1_0_en_us"}, "banking77": {"const": "banking77"}}},
    "quotas": {"type": "object", "additionalProperties": false, "required": ["near_domain_unsupported", "far_out_of_domain", "ambiguous_adversarial_insufficient", "public_total"], "properties": {"near_domain_unsupported": {"type": "object", "additionalProperties": false, "required": ["clinc150", "massive_en_us"], "properties": {"clinc150": {"const": 60}, "massive_en_us": {"const": 45}}}, "far_out_of_domain": {"type": "object", "additionalProperties": false, "required": ["massive_en_us", "banking77"], "properties": {"massive_en_us": {"const": 90}, "banking77": {"const": 45}}}, "ambiguous_adversarial_insufficient": {"type": "object", "additionalProperties": false, "required": ["clinc150_oos"], "properties": {"clinc150_oos": {"const": 75}}}, "public_total": {"const": 315}}},
    "partition_policy": {"type": "object", "additionalProperties": false, "required": ["clinc150", "massive_1_0_en_us", "banking77"], "properties": {"clinc150": {"const": ["train", "val", "test"]}, "massive_1_0_en_us": {"const": ["train", "dev", "test"]}, "banking77": {"const": ["train", "test"]}}},
    "label_policy": {"type": "object", "additionalProperties": false, "required": ["clinc150", "massive_1_0_en_us", "banking77", "clinc150_oos"], "properties": {"clinc150": {"type": "object", "additionalProperties": false, "minProperties": 1, "additionalProperties": {"enum": ["near_domain_unsupported", "ineligible_for_gate2_public"]}}, "massive_1_0_en_us": {"type": "object", "additionalProperties": false, "minProperties": 1, "additionalProperties": {"enum": ["near_domain_unsupported", "far_out_of_domain", "ineligible_for_gate2_public"]}}, "banking77": {"type": "object", "additionalProperties": false, "minProperties": 1, "additionalProperties": {"enum": ["far_out_of_domain", "ineligible_for_gate2_public"]}}, "clinc150_oos": {"type": "object", "additionalProperties": false, "required": ["oos_train", "oos_val", "oos_test"], "additionalProperties": {"enum": ["ambiguous_adversarial_insufficient", "ineligible_for_gate2_public"]}}}},
    "expected_behavior": {"type": "object", "additionalProperties": false, "required": ["near_domain_unsupported", "far_out_of_domain", "ambiguous_adversarial_insufficient"], "properties": {"near_domain_unsupported": {"enum": ["assist_ungrounded_only", "request_clarification", "abstain", "partially_grounded"]}, "far_out_of_domain": {"enum": ["assist_ungrounded_only", "abstain"]}, "ambiguous_adversarial_insufficient": {"enum": ["request_clarification", "abstain", "assist_ungrounded_only"]}}},
    "expected_behavior_by_label": {"type": "object", "additionalProperties": false, "required": ["clinc150", "massive_1_0_en_us", "banking77", "clinc150_oos"], "properties": {"clinc150": {"type": "object", "additionalProperties": {"enum": ["request_clarification", "abstain", "assist_ungrounded_only", "partially_grounded"]}}, "massive_1_0_en_us": {"type": "object", "additionalProperties": {"enum": ["request_clarification", "abstain", "assist_ungrounded_only", "partially_grounded"]}}, "banking77": {"type": "object", "additionalProperties": {"enum": ["request_clarification", "abstain", "assist_ungrounded_only", "partially_grounded"]}}, "clinc150_oos": {"type": "object", "additionalProperties": {"enum": ["request_clarification", "abstain", "assist_ungrounded_only", "partially_grounded"]}}}},
    "mixed_cluster_resolution": {"type": "object", "additionalProperties": false, "required": ["method", "overrides", "reason", "post_policy_behavior"], "properties": {"method": {"const": "frozen_label_disposition_before_selection"}, "overrides": {"type": "object", "additionalProperties": {"enum": ["near_domain_unsupported", "far_out_of_domain", "ineligible_for_gate2_public"]}}, "reason": {"type": "string", "minLength": 1}, "post_policy_behavior": {"const": "any remaining mixed cluster is a hard failure"}}},
    "group_policy": {"type": "object", "additionalProperties": false, "required": ["algorithm_id", "format", "singleton_rule", "union_rules", "template_priority"], "properties": {"algorithm_id": {"const": "gate2-source-leakage-group-v1"}, "format": {"const": "G2-<dataset-short>-<sha256-prefix>"}, "singleton_rule": {"const": "only when no source/template relationship is evidenced"}, "union_rules": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "template_priority": {"type": "array", "items": {"enum": ["source_provided_family", "deterministic_structural_family", "null"]}}}},
    "duplicate_policy": {"type": "object", "additionalProperties": false, "required": ["exact", "near", "mixed_stratum_failure"], "properties": {"exact": {"const": "canonical_text_global_hard_reject"}, "near": {"const": "reuse_stage5_exhaustive_comparison_and_fingerprint_bound_dispositions"}, "mixed_stratum_failure": {"const": "mixed_stratum_leakage_cluster"}}},
    "balance_algorithm": {"const": "balanced_round_robin_over_sha256_sorted_eligible_labels_with_exact_whole_cluster_resolution"},
    "future_split_constraints": {"type": "object", "additionalProperties": false, "required": ["near_clinc150", "near_massive_en_us", "far_massive_en_us", "far_banking77", "ambiguous_clinc150_oos"], "properties": {"near_clinc150": {"const": [45, 15]}, "near_massive_en_us": {"const": [30, 15]}, "far_massive_en_us": {"const": [50, 40]}, "far_banking77": {"const": [25, 20]}, "ambiguous_clinc150_oos": {"const": [75, 0]}}},
    "no_performance_peek": {"const": true},
    "no_split": {"const": true}
  }
}
